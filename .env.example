# Base URL of the KidStorePeru backend API.
# The committed .env already has the production value; for local development
# create a .env.local with your own (e.g. http://localhost:8080).
VITE_API_URL=https://kidstoreperu-backend-production-37cb.up.railway.app

# Soles (S/) charged per 100 pavos; the shop shows every item priced with it.
# Optional: 1.30 when not set.
# VITE_SOLES_PER_100_PAVOS=1.30
